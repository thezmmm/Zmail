# ─── OpenAI (LLM + embeddings) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 可选：自定义 base URL（兼容 OpenAI API 的代理或第三方服务）
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zmail
DB_USER=zmail
DB_PASSWORD=changeme

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ─── Gmail OAuth2 ─────────────────────────────────────────────────────────────
# Create an OAuth2 app at https://console.cloud.google.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/auth/gmail/callback

# ─── Microsoft Graph OAuth2 ───────────────────────────────────────────────────
# Register an app at https://portal.azure.com → App Registrations
# Uncomment when ready — leaving these empty causes startup failure
# MSGRAPH_CLIENT_ID=
# MSGRAPH_CLIENT_SECRET=
# MSGRAPH_TENANT_ID=common
# MSGRAPH_REDIRECT_URI=http://localhost:8080/api/v1/auth/msgraph/callback

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_EXPIRY_MS=86400000

# ─── Proxy (optional, for restricted network environments) ────────────────────
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7890

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=dev
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000